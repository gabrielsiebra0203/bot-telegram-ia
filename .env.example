# Provedor: Google Gemini (camada compatível com OpenAI)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=cole-sua-chave-aqui
# Nome exato do modelo, obtido com: python app/listar_modelos.py flash
LLM_MODELO=nome-do-modelo-flash
# Opcional: esforço de raciocínio (minimal/low/medium/high). Menos = mais rápido e mais barato.
LLM_REASONING=low
# Opcional: caminho do banco de clima (padrão: dados/clima.db)
# CLIMA_DB=
# Token do bot obtido com o BotFather no Telegram
TELEGRAM_BOT_TOKEN=cole-seu-token-aqui